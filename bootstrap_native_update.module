<?php

/**
 * @file
 * Bootstrap Native: provides the theme (in themes/bootstrap_native, so one
 * git pull or download updates theme and module together), the Bootstrap
 * updates page and the sub-theme generator.
 */

/**
 * Implements hook_system_theme_info().
 *
 * Drupal only looks for themes in themes/ folders; this tells it about the
 * one inside this module.
 */
function bootstrap_native_update_system_theme_info() {
  return array(
    'bootstrap_native' => drupal_get_path('module', 'bootstrap_native_update') . '/themes/bootstrap_native/bootstrap_native.info',
  );
}

/**
 * Implements hook_system_info_alter().
 *
 * Disabling the module would remove the theme, so it can't be disabled
 * while Bootstrap Native or a sub-theme of it is enabled.
 */
function bootstrap_native_update_system_info_alter(&$info, $file, $type) {
  if ($type == 'module' && $file->name == 'bootstrap_native_update' && ($themes = bootstrap_native_update_themes_in_use())) {
    $info['required'] = TRUE;
    $info['explanation'] = format_plural(count($themes), 'The theme @themes uses it', 'The themes @themes use it', array('@themes' => implode(', ', $themes)));
  }
}

/**
 * Enabled themes that are Bootstrap Native or built on it.
 *
 * @return array
 *   Theme names (human-readable), keyed by machine name.
 */
function bootstrap_native_update_themes_in_use() {
  $themes = list_themes();
  $in_use = array();
  foreach ($themes as $key => $theme) {
    if (!$theme->status) {
      continue;
    }
    if ($key == 'bootstrap_native' || (!empty($theme->info['base theme']) && array_key_exists('bootstrap_native', drupal_find_base_themes($themes, $key)))) {
      $in_use[$key] = $theme->info['name'];
    }
  }
  return $in_use;
}

/**
 * Whether the site has its own Bootstrap Native theme yet.
 *
 * @return string
 *   '' when the default theme is a sub-theme of Bootstrap Native; 'base'
 *   when the default theme is Bootstrap Native itself (sites from before it
 *   was hidden); 'none' when no sub-theme is the default.
 */
function bootstrap_native_update_site_theme_state() {
  $default = variable_get('theme_default', 'bartik');
  if ($default == 'bootstrap_native') {
    return 'base';
  }
  $themes = list_themes();
  if (isset($themes[$default]) && !empty($themes[$default]->info['base theme']) && array_key_exists('bootstrap_native', drupal_find_base_themes($themes, $default))) {
    return '';
  }
  return 'none';
}

/**
 * The "create your site's theme" prompt, or an empty array.
 */
function bootstrap_native_update_site_theme_prompt() {
  $state = bootstrap_native_update_site_theme_state();
  if ($state === '' || !user_access('create bootstrap native sub-themes')) {
    return array();
  }
  $text = $state == 'base'
    ? t("<strong>Move to your own theme.</strong> This site uses Bootstrap Native directly, so there is no safe place for its own styles and templates (updates overwrite the theme's files). One click creates the site's theme with the same settings and switches to it; nothing changes on the pages.")
    : t("<strong>Create your site's theme to start using Bootstrap Native.</strong> Bootstrap Native is a foundation: the site uses a theme built on it, where its own styles and templates go, safe from updates. It starts with Bootstrap Native's look and settings.");
  $button = l($state == 'base' ? t('Move to your own theme') : t("Create your site's theme"), 'admin/appearance/bootstrap-native-subtheme', array('attributes' => array('class' => array('button'))));
  return array(
    '#markup' => '<div class="messages warning bnu-site-theme" role="status">' . $text . ' ' . $button . '</div>',
  );
}

/**
 * Implements hook_help().
 */
function bootstrap_native_update_help($path, $arg) {
  if ($path == 'admin/appearance' && ($prompt = bootstrap_native_update_site_theme_prompt())) {
    return $prompt['#markup'];
  }
}

/**
 * Implements hook_permission().
 */
function bootstrap_native_update_permission() {
  return array(
    'administer bootstrap native updates' => array(
      'title' => t('Check and apply Bootstrap updates'),
      'description' => t('Download new Bootstrap releases, check them, preview them and switch the site to them.'),
      'restrict access' => TRUE,
    ),
    'create bootstrap native sub-themes' => array(
      'title' => t('Create Bootstrap Native sub-themes'),
      'description' => t("Writes a new theme's files into the site's themes folder."),
      'restrict access' => TRUE,
    ),
  );
}

/**
 * Implements hook_theme().
 */
function bootstrap_native_update_theme() {
  return array(
    'bootstrap_native_update_components_table' => array(
      'render element' => 'element',
      'file' => 'includes/components.inc',
    ),
  );
}

/**
 * Implements hook_menu().
 */
function bootstrap_native_update_menu() {
  $base = array(
    'access arguments' => array('administer bootstrap native updates'),
    'file' => 'includes/admin.inc',
  );
  $items['admin/appearance/bootstrap-updates'] = array(
    'title' => 'Bootstrap updates',
    'description' => 'Check new Bootstrap releases for breaks before applying them.',
    'page callback' => 'bootstrap_native_update_overview_page',
    'type' => MENU_LOCAL_TASK,
    'weight' => 5,
  ) + $base;
  $items['admin/appearance/bootstrap-updates/result/%'] = array(
    'title callback' => 'bootstrap_native_update_result_title',
    'title arguments' => array(4),
    'page callback' => 'bootstrap_native_update_result_page',
    'page arguments' => array(4),
  ) + $base;
  $items['admin/appearance/bootstrap-components'] = array(
    'title' => 'Bootstrap components',
    'description' => "Choose which of Bootstrap's parts the site's stylesheet includes.",
    'page callback' => 'drupal_get_form',
    'page arguments' => array('bootstrap_native_update_components_form'),
    'type' => MENU_LOCAL_TASK,
    'weight' => 6,
    'file' => 'includes/components.inc',
  ) + $base;
  $items['admin/appearance/bootstrap-native-subtheme'] = array(
    'title' => 'Create a Bootstrap Native sub-theme',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('bootstrap_native_update_subtheme_form'),
    'access arguments' => array('create bootstrap native sub-themes'),
    'type' => MENU_LOCAL_ACTION,
    'file' => 'includes/subtheme_form.inc',
  );
  // One-click actions; each takes a token (no request forgery).
  $items['admin/appearance/bootstrap-updates/action/%/%'] = array(
    'page callback' => 'bootstrap_native_update_action',
    'page arguments' => array(4, 5),
    'type' => MENU_CALLBACK,
  ) + $base;
  return $items;
}

/**
 * The files the page should use, or NULL for the theme's own.
 *
 * The build being previewed (only for the admin previewing it), else the
 * active build; for a theme with own or fixed parts, its build of either.
 *
 * @return array|null
 *   Keys build, css (path from the Drupal root), js (URL).
 */
function bootstrap_native_update_files() {
  $files = &drupal_static(__FUNCTION__, FALSE);
  if ($files !== FALSE) {
    return $files;
  }
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  $files = NULL;
  $theme = !empty($GLOBALS['theme_key']) ? $GLOBALS['theme_key'] : variable_get('theme_default', 'bartik');
  $own = bootstrap_native_update_preview_theme();
  $build = $own && $own['theme'] === $theme ? $own['build'] : bootstrap_native_update_build_for_theme($theme, bootstrap_native_update_preview());
  $builds = bootstrap_native_update_builds();
  if ($build !== '' && !empty($builds[$build]['meta'])) {
    $uri = bootstrap_native_update_build_uri($build);
    // Files gone (a copied site, a cleanup): this page uses the theme's own
    // files instead, and the next cache clear or cron run rebuilds them.
    $path = file_stream_wrapper_get_instance_by_uri($uri)->getDirectoryPath() . '/bootstrap-native/builds/' . $build;
    if (!is_file(DRUPAL_ROOT . '/' . $path . '/bootstrap_native.css') || !is_file(DRUPAL_ROOT . '/' . $path . '/bootstrap.bundle.min.js')) {
      if (!variable_get('bootstrap_native_update_repair', FALSE)) {
        variable_set('bootstrap_native_update_repair', TRUE);
        watchdog('bootstrap_native', 'The files of the Bootstrap build @build are missing; pages use the theme\'s own files until the next cache clear or cron run rebuilds them.', array('@build' => $build), WATCHDOG_WARNING);
      }
      return $files;
    }
    $files = array(
      'build' => $build,
      'css' => file_stream_wrapper_get_instance_by_uri($uri)->getDirectoryPath() . '/bootstrap-native/builds/' . $build . '/bootstrap_native.css',
      'js' => file_create_url($uri . '/bootstrap.bundle.min.js') . '?' . $builds[$build]['meta']['stamp'],
    );
  }
  return $files;
}

/**
 * The scss/_colors.scss of the release the site uses (named colors).
 */
function bootstrap_native_update_palette_file() {
  $active = variable_get('bootstrap_native_update_active', '');
  $theme = drupal_get_path('module', 'bootstrap_native_update') . '/themes/bootstrap_native';
  if ($active === '' || strpos($active, '~') === FALSE) {
    return DRUPAL_ROOT . '/' . $theme . '/vendor/bootstrap/scss/_colors.scss';
  }
  $version = substr($active, 0, strrpos($active, '~'));
  $shipped = trim((string) @file_get_contents(DRUPAL_ROOT . '/' . $theme . '/vendor/bootstrap/VERSION'));
  if ($version === $shipped) {
    return DRUPAL_ROOT . '/' . $theme . '/vendor/bootstrap/scss/_colors.scss';
  }
  return DRUPAL_ROOT . '/' . file_stream_wrapper_get_instance_by_uri('public://')->getDirectoryPath() . '/bootstrap-native/releases/' . $version . '/bootstrap/scss/_colors.scss';
}

/**
 * The build this admin is previewing, or NULL.
 */
function bootstrap_native_update_preview() {
  if (empty($_SESSION['bootstrap_native_update_preview']) || !user_access('administer bootstrap native updates')) {
    return NULL;
  }
  $build = $_SESSION['bootstrap_native_update_preview'];
  $builds = variable_get('bootstrap_native_update_builds', array());
  return !empty($builds[$build]['meta']) ? $build : NULL;
}

/**
 * A theme's own parts this admin is previewing (from its settings page).
 *
 * @return array|null
 *   Keys theme, build; or NULL.
 */
function bootstrap_native_update_preview_theme() {
  if (empty($_SESSION['bootstrap_native_update_preview_theme']['build']) || !user_access('administer bootstrap native updates')) {
    return NULL;
  }
  $preview = $_SESSION['bootstrap_native_update_preview_theme'];
  $builds = variable_get('bootstrap_native_update_builds', array());
  return is_string($preview['build']) && !empty($builds[$preview['build']]['meta']) ? $preview : NULL;
}

/**
 * Scripts (ES modules) the active theme and its base themes bring.
 *
 * In a sub-theme's .info: bootstrap_native[js][] = js/plugin.js. They load
 * after Bootstrap's script and can import it by name:
 * import { BaseComponent } from "bootstrap".
 *
 * @return array
 *   URLs.
 */
function bootstrap_native_update_theme_scripts($theme_key) {
  $themes = list_themes();
  if (!isset($themes[$theme_key])) {
    return array();
  }
  $chain = array_reverse(array_keys(drupal_find_base_themes($themes, $theme_key)));
  $chain[] = $theme_key;
  $urls = array();
  foreach (array_reverse($chain) as $name) {
    if (empty($themes[$name]->info['bootstrap_native']['js'])) {
      continue;
    }
    foreach ((array) $themes[$name]->info['bootstrap_native']['js'] as $file) {
      $path = dirname($themes[$name]->filename) . '/' . $file;
      if (strpos($file, '..') === FALSE && preg_match('/\.m?js$/', $file) && is_file(DRUPAL_ROOT . '/' . $path)) {
        $urls[] = file_create_url($path) . '?' . variable_get('css_js_query_string', '0');
      }
    }
  }
  return $urls;
}

/**
 * Implements hook_css_alter().
 *
 * Swaps the theme's stylesheet for the build of the active (or previewed)
 * release.
 */
function bootstrap_native_update_css_alter(&$css) {
  $theme_css = drupal_get_path('module', 'bootstrap_native_update') . '/themes/bootstrap_native/css/bootstrap_native.css';
  if (isset($css[$theme_css]) && ($files = bootstrap_native_update_files())) {
    $item = $css[$theme_css];
    $item['data'] = $files['css'];
    unset($css[$theme_css]);
    $css[$files['css']] = $item;
  }
}

/**
 * Implements hook_page_build().
 *
 * The preview bar, for the admin previewing a release.
 */
function bootstrap_native_update_page_build(&$page) {
  $own = bootstrap_native_update_preview_theme();
  if ($own && $own['theme'] === $GLOBALS['theme_key']) {
    module_load_include('inc', 'bootstrap_native_update', 'includes/admin');
    $page['page_top']['bootstrap_native_update_preview'] = bootstrap_native_update_preview_bar($own['build'], $own['theme']);
    return;
  }
  $build = bootstrap_native_update_preview();
  if ($build === NULL || path_is_admin(current_path()) && current_path() != 'admin/appearance/bootstrap-updates' && empty(bootstrap_native_update_builds_for_preview($build)[$GLOBALS['theme_key']])) {
    return;
  }
  module_load_include('inc', 'bootstrap_native_update', 'includes/admin');
  $page['page_top']['bootstrap_native_update_preview'] = bootstrap_native_update_preview_bar($build);
}

/**
 * The theme builds a previewed release brings (admin pages show the bar
 * too when their theme has one).
 */
function bootstrap_native_update_builds_for_preview($build) {
  $builds = variable_get('bootstrap_native_update_builds', array());
  return isset($builds[$build]['theme_builds']) ? $builds[$build]['theme_builds'] : array();
}

/**
 * Implements hook_form_FORM_ID_alter() for system_theme_settings().
 *
 * On the settings of Bootstrap Native and its sub-themes: a notice when a
 * new release is out, and the theme's Bootstrap components (step 6).
 */
function bootstrap_native_update_form_system_theme_settings_alter(&$form, &$form_state) {
  $theme = isset($form_state['build_info']['args'][0]) ? $form_state['build_info']['args'][0] : '';
  if (!$theme || !user_access('administer bootstrap native updates') || !array_key_exists($theme, bootstrap_native_update_themes_in_use())) {
    return;
  }
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  module_load_include('inc', 'bootstrap_native_update', 'includes/theme_parts');
  // AJAX rebuilds (the color preview) load the form from cache.
  $form_state['build_info']['files']['bootstrap_native_update'] = drupal_get_path('module', 'bootstrap_native_update') . '/includes/theme_parts.inc';
  bootstrap_native_update_theme_parts_step($form, $form_state, $theme);
  if ($release = bootstrap_native_update_available()) {
    $form['bootstrap_native_update_notice'] = array(
      '#type' => 'container',
      '#attributes' => array('class' => array('messages', 'warning')),
      '#weight' => -100,
      'text' => array(
        '#markup' => t('Bootstrap @new is available (this site runs @current). <a href="@url">Bootstrap updates</a>', array(
          '@new' => $release['version'],
          '@current' => bootstrap_native_update_active_version(),
          '@url' => url('admin/appearance/bootstrap-updates'),
        )),
      ),
    );
  }
}

/**
 * Implements hook_cron().
 */
function bootstrap_native_update_cron() {
  // Repairs run from hook_flush_caches(), which core's cron calls too.
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  if (variable_get('bootstrap_native_update_daily', 0) && variable_get('bootstrap_native_update_checked', 0) < REQUEST_TIME - 86400 + 600) {
    bootstrap_native_update_refresh_releases();
  }
  bootstrap_native_update_cleanup();
}

/**
 * Implements hook_themes_enabled().
 *
 * A theme with fixed parts (the admin theme) gets its build right away.
 */
function bootstrap_native_update_themes_enabled($theme_list) {
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  list_themes(TRUE);
  bootstrap_native_update_rebuild_theme_builds();
}

/**
 * Implements hook_themes_disabled().
 */
function bootstrap_native_update_themes_disabled($theme_list) {
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  list_themes(TRUE);
  bootstrap_native_update_rebuild_theme_builds();
}

/**
 * Implements hook_flush_caches().
 *
 * Repairs builds whose files are missing or damaged, then rebuilds the
 * active one if the code or the sub-themes changed. Nothing happens when
 * all is in order. See bootstrap_native_update_repair() and
 * bootstrap_native_update_rebuild_if_stale().
 */
function bootstrap_native_update_flush_caches() {
  module_load_include('inc', 'bootstrap_native_update', 'includes/releases');
  bootstrap_native_update_repair();
  bootstrap_native_update_rebuild_if_stale();
  return array();
}
