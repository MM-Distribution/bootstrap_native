name = Bootstrap Native
description = Bootstrap 6 styling on Drupal's own markup: forms, menus and messages keep the structure and classes modules expect.
core = 7.x
version = 7.x-1.0-dev
screenshot = screenshot.png

; A foundation, not a site theme: sites use a sub-theme of it (their own
; styles and templates go there, safe from updates). Hidden from the
; Appearance page; the module offers to create the site's theme.
hidden = TRUE

; Compiled from scss/ by build/build.sh (Bootstrap 6.0.0-alpha.1 in vendor/bootstrap).
stylesheets[all][] = css/bootstrap_native.css

regions[header]         = Header
regions[navigation]     = Navigation
regions[highlighted]    = Highlighted
regions[help]           = Help
regions[content]        = Content
regions[sidebar_first]  = First sidebar
regions[sidebar_second] = Second sidebar
regions[footer]         = Footer
regions[page_top]       = Page top
regions[page_bottom]    = Page bottom

features[] = logo
features[] = name
features[] = slogan
features[] = favicon
features[] = main_menu
features[] = secondary_menu

; A base theme has no logo of its own: sites upload theirs (no logo.png).
settings[default_logo] = 0

; Colors: empty means Bootstrap's own (see theme-settings.php).
settings[bootstrap_native_color_primary] = ''
settings[bootstrap_native_color_secondary] = ''
settings[bootstrap_native_color_base] = ''
settings[bootstrap_native_color_text] = ''
settings[bootstrap_native_color_link] = ''
settings[bootstrap_native_color_link_hover] = ''

; Bootstrap parts the theme never builds: Drupal uses the same class names
; for other things (shown on Appearance > Bootstrap components).
bootstrap_native[exclude][placeholder] = "Drupal's <em class=\"placeholder\"> in messages uses the same class"
bootstrap_native[exclude][progress] = "Drupal's progress bar (batch, uploads) uses the same class; the theme styles Drupal's"
bootstrap_native[exclude][forms/form-text] = ".form-text is Drupal's text input; help text is Drupal's .description"
bootstrap_native[exclude][forms/floating-labels] = "Needs its own markup (a wrapper and a placeholder on every field); the Floating Labels module does this on Drupal's"
